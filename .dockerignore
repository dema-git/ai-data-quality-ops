# Exclude everything by default. Docker builds should only receive files
# that are required by Dockerfiles and the test runner.
*

!services/
!services/**
!scripts/
!scripts/**
!tests/
!tests/**

!docker-compose*.yml
!Makefile
!.env.example
!.dockerignore

.git/
.idea/
.agents/
.codex/

.env
*.env

minio-data/
pgdata/
shared_logs/

**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage*
htmlcov/

*.log
log.txt
.DS_Store
